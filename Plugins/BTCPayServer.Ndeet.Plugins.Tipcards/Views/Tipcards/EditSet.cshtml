@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Ndeet.Plugins.Tipcards
@using BTCPayServer.Ndeet.Plugins.Tipcards.ViewModels
@inject IScopeProvider ScopeProvider
@model EditTipcardSetViewModel
@{
    Layout = "_Layout";
    var storeId = ScopeProvider.GetCurrentStoreId();
    ViewData.SetLayoutModel(new LayoutModel(nameof(TipcardsPages.Sets), "Edit Tipcard Set") { ActiveCategory = nameof(TipcardsPages) });
}

<div class="sticky-header-setup"></div>
<div class="sticky-header d-sm-flex align-items-center justify-content-between">
    <h2 class="mb-0">@ViewData["Title"]</h2>
</div>

<partial name="_StatusMessage" />

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <form method="post" asp-action="EditSet" asp-route-storeId="@storeId" asp-route-setId="@Model.SetId">
            <div class="form-group">
                <label asp-for="Name" class="form-label" data-required></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="d-flex gap-3">
                <div class="form-group flex-fill">
                    <label asp-for="SatsPerCard" class="form-label" data-required></label>
                    <input asp-for="SatsPerCard" class="form-control" type="number" min="1" max="1000000000" id="satsPerCard" />
                    <span asp-validation-for="SatsPerCard" class="text-danger"></span>
                    <div class="form-text">Changing this resets activated, unclaimed cards. Their existing QR codes stay valid.</div>
                </div>
                <div class="form-group flex-fill">
                    <label asp-for="NumberOfCards" class="form-label" data-required></label>
                    <input asp-for="NumberOfCards" class="form-control" type="number" min="1" max="500" id="numberOfCards" />
                    <span asp-validation-for="NumberOfCards" class="text-danger"></span>
                    @if (Model.ClaimedCount > 0)
                    {
                        <div class="form-text">@Model.ClaimedCount already claimed &mdash; minimum is @Model.ClaimedCount.</div>
                    }
                </div>
            </div>
            <div class="form-group">
                <div class="bg-light rounded p-2 d-flex gap-3 align-items-center">
                    <span class="text-muted">Total:</span>
                    <strong id="totalSats">@((Model.SatsPerCard * Model.NumberOfCards).ToString("N0"))</strong>
                    <span class="text-muted">sats</span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="CardHeadline" class="form-label"></label>
                <input asp-for="CardHeadline" class="form-control" />
                <div class="form-text">Shown on printed cards and the claim page.</div>
            </div>
            <div class="form-group">
                <label asp-for="CardText" class="form-label"></label>
                <textarea asp-for="CardText" class="form-control" rows="2"></textarea>
                <div class="form-text">Shown on printed cards and the claim page below the QR code.</div>
            </div>
            <div class="form-group">
                <label asp-for="QrLogo" class="form-label"></label>
                <div>
                    @foreach (var logoType in Enum.GetValues<QrLogoType>())
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="QrLogo" value="@logoType" id="qrLogo_@logoType" />
                            <label class="form-check-label" for="qrLogo_@logoType">@logoType</label>
                        </div>
                    }
                </div>
                <div class="form-text">Small logo overlay in the center of the QR code.</div>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Save</button>
            <a asp-action="ViewSet" asp-route-storeId="@storeId" asp-route-setId="@Model.SetId" class="btn btn-secondary mt-3 ms-2">Cancel</a>
        </form>
    </div>
</div>

@section PageFootContent {
    <script>
        (function () {
            var satsInput = document.getElementById('satsPerCard');
            var countInput = document.getElementById('numberOfCards');
            var totalEl = document.getElementById('totalSats');

            function updateTotal() {
                var sats = parseInt(satsInput.value) || 0;
                var count = parseInt(countInput.value) || 0;
                totalEl.textContent = (sats * count).toLocaleString();
            }

            satsInput.addEventListener('input', updateTotal);
            countInput.addEventListener('input', updateTotal);
        })();
    </script>
}
