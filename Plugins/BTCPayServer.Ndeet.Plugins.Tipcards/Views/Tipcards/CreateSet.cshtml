@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Ndeet.Plugins.Tipcards
@using BTCPayServer.Ndeet.Plugins.Tipcards.ViewModels
@inject IScopeProvider ScopeProvider
@model CreateTipcardSetViewModel
@{
    Layout = "_Layout";
    var storeId = ScopeProvider.GetCurrentStoreId();
    ViewData.SetLayoutModel(new LayoutModel(nameof(TipcardsPages.Sets), "Create Tipcard Set") { ActiveCategory = nameof(TipcardsPages) });
}

<div class="sticky-header-setup"></div>
<div class="sticky-header d-sm-flex align-items-center justify-content-between">
    <h2 class="mb-0">@ViewData["Title"]</h2>
</div>

<partial name="_StatusMessage" />

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <form method="post" asp-action="CreateSet" asp-route-storeId="@storeId">
            <h4 class="mt-2 mb-3">Set Details</h4>
            <div class="form-group">
                <label asp-for="Name" class="form-label" data-required></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Bitcoin Conference 2026" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SatsPerCard" class="form-label" data-required></label>
                <input asp-for="SatsPerCard" class="form-control" type="number" min="1" />
                <span asp-validation-for="SatsPerCard" class="text-danger"></span>
                <div class="form-text">Amount of satoshis each tipcard will be worth.</div>
            </div>
            <div class="form-group">
                <label asp-for="NumberOfCards" class="form-label" data-required></label>
                <input asp-for="NumberOfCards" class="form-control" type="number" min="1" max="500" />
                <span asp-validation-for="NumberOfCards" class="text-danger"></span>
                <div class="form-text">Pull payments are created only when cards are first scanned. Max 500 per set.</div>
            </div>

            <div class="form-group mt-2">
                <div class="d-flex gap-3">
                    <span class="text-muted">Total:</span>
                    <strong id="totalSats">-</strong> sats
                </div>
            </div>

            <h4 class="mt-5 mb-3">Card Customization</h4>
            <div class="form-group">
                <label asp-for="CardHeadline" class="form-label"></label>
                <input asp-for="CardHeadline" class="form-control" />
                <div class="form-text">Shown on printed cards and the claim page.</div>
            </div>
            <div class="form-group">
                <label asp-for="CardText" class="form-label"></label>
                <textarea asp-for="CardText" class="form-control" rows="2"></textarea>
                <div class="form-text">Shown on the claim page below the QR code.</div>
            </div>
            <div class="form-group">
                <label asp-for="QrLogo" class="form-label"></label>
                <div>
                    @foreach (var logoType in Enum.GetValues<QrLogoType>())
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="QrLogo" value="@logoType" id="qrLogo_@logoType" />
                            <label class="form-check-label" for="qrLogo_@logoType">@logoType</label>
                        </div>
                    }
                </div>
                <div class="form-text">Small logo overlay in the center of the QR code.</div>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Create Set</button>
            <a asp-action="ListSets" asp-route-storeId="@storeId" class="btn btn-secondary mt-3 ms-2">Cancel</a>
        </form>
    </div>
</div>

@section PageFootContent {
    <script>
        const satsInput = document.getElementById('SatsPerCard');
        const cardsInput = document.getElementById('NumberOfCards');
        const totalDisplay = document.getElementById('totalSats');
        function updateTotal() {
            const sats = parseInt(satsInput.value) || 0;
            const cards = parseInt(cardsInput.value) || 0;
            totalDisplay.textContent = (sats * cards).toLocaleString();
        }
        satsInput.addEventListener('input', updateTotal);
        cardsInput.addEventListener('input', updateTotal);
        updateTotal();
    </script>
}
