@using BTCPayServer.Components.QRCode
@using BTCPayServer.Ndeet.Plugins.Tipcards
@using BTCPayServer.Ndeet.Plugins.Tipcards.ViewModels
@using BTCPayServer.Security
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PrintTipcardSetViewModel
@inject ContentSecurityPolicies Csp
@{
    Layout = null;
    var unclaimed = Model.Cards.Where(c => !c.IsClaimed).ToList();
    var storeId = ViewContext.RouteData.Values["storeId"]?.ToString();
    var setId = ViewContext.RouteData.Values["setId"]?.ToString();
    var pdfUrl = Url.Action("DownloadPdf", "Tipcards", new { storeId, setId });
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Print - @Model.SetName</title>
    <link href="~/main/bootstrap/bootstrap.css" asp-append-version="true" rel="stylesheet" />
    <style id="pageStyle">
        @@page { size: A4; margin: 10mm; }
    </style>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; margin: 0; }

        /* --- Options toolbar --- */
        .print-options {
            padding: 16px 20px;
            background: #f8f9fa;
            border-bottom: 1px solid #ddd;
        }
        .print-options h4 { margin: 0 0 4px 0; }
        .print-options .text-muted { font-size: 0.85rem; margin-bottom: 12px; }
        .options-row {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: end;
        }
        .option-group {
            display: flex;
            flex-direction: column;
        }
        .option-group > label {
            font-size: 0.7rem;
            font-weight: 600;
            color: #666;
            margin-bottom: 3px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .option-group select,
        .option-group input[type="number"] {
            padding: 5px 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.85rem;
        }
        .option-group input[type="number"] { width: 80px; }
        .custom-size { display: none; gap: 8px; align-items: end; }
        .custom-size.visible { display: flex; }
        .custom-size .times { padding-bottom: 6px; color: #999; font-size: 0.9rem; }
        .option-check {
            display: flex;
            align-items: center;
            gap: 6px;
            padding-bottom: 2px;
        }
        .option-check input[type="checkbox"] { width: 16px; height: 16px; accent-color: #0d6efd; }
        .option-check span { font-size: 0.85rem; }
        .btn-group-print { display: flex; gap: 8px; align-items: end; }

        /* --- Print grid --- */
        .print-grid {
            display: grid;
            grid-template-columns: repeat(var(--cols, 3), 1fr);
            gap: 0;
            padding: 0;
        }

        /* --- Card: 2-column layout --- */
        .tipcard {
            padding: 8px 6px;
            page-break-inside: avoid;
            break-inside: avoid;
            overflow: hidden;
        }
        .tipcard-inner {
            display: flex;
            align-items: flex-start;
            gap: 6px;
        }
        .tipcard-qr {
            flex: 0 1 auto;
            text-align: center;
        }
        .tipcard-info {
            flex: 1;
            min-width: 0;
            padding-top: 2px;
        }
        .tipcard .logo { max-height: 24px; margin-bottom: 4px; display: block; }
        .tipcard .headline { font-size: 12px; font-weight: 600; margin: 0 0 3px 0; line-height: 1.2; }
        .tipcard .card-text { font-size: 10px; color: #555; margin: 0 0 3px 0; line-height: 1.3; }
        .tipcard .sats { font-size: 13px; font-weight: 700; margin: 3px 0 0 0; }
        .tipcard .qr-container { position: relative; display: inline-block; }
        .tipcard .qr-container img { width: 100%; max-width: 110px; height: auto; image-rendering: pixelated; }
        .tipcard .store-name { font-size: 9px; color: #999; margin-top: 3px; }

        /* --- Cutting markers --- */
        .print-grid.with-markers {
            border-top: 0.5pt solid #888;
            border-left: 0.5pt solid #888;
        }
        .print-grid.with-markers .tipcard {
            border-right: 0.5pt solid #888;
            border-bottom: 0.5pt solid #888;
        }

        /* --- QR logo overlay --- */
        .qr-logo-overlay {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 26px; height: 26px; border-radius: 4px; padding: 2px;
            display: flex; align-items: center; justify-content: center;
        }
        .qr-logo-overlay svg { width: 20px; height: 20px; }
        .qr-logo-overlay-badge {
            width: 100%; height: 100%; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff; box-shadow: 0 0 0 2px #fff;
        }
        .qr-logo-overlay-badge-lightning { background: #f7931a; }
        .qr-logo-overlay-symbol { color: #fff; font-size: 1rem; line-height: 1; }

        @@media print {
            .print-options { display: none !important; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="print-options">
        <h4>@Model.SetName &mdash; @unclaimed.Count unclaimed cards at @Model.SatsPerCard.ToString("N0") sats each</h4>
        <p class="text-muted">Only unclaimed cards are shown. Adjust settings below, then download as PDF or print.</p>
        <div class="options-row">
            <div class="option-group">
                <label>Paper Size</label>
                <select id="paperSize">
                    <option value="A4" selected>A4 (210 &times; 297 mm)</option>
                    <option value="A3">A3 (297 &times; 420 mm)</option>
                    <option value="letter">US Letter (8.5 &times; 11 in)</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="custom-size" id="customSize">
                <div class="option-group">
                    <label>Width (mm)</label>
                    <input type="number" id="customWidth" value="210" min="50" max="1000" />
                </div>
                <span class="times">&times;</span>
                <div class="option-group">
                    <label>Height (mm)</label>
                    <input type="number" id="customHeight" value="297" min="50" max="1000" />
                </div>
            </div>
            <div class="option-group">
                <label>Columns</label>
                <select id="columns">
                    <option value="2">2</option>
                    <option value="3" selected>3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>
            </div>
            <div class="option-group">
                <label>Cutting Markers</label>
                <div class="option-check">
                    <input type="checkbox" id="cuttingMarkers" checked />
                    <span>Enabled</span>
                </div>
            </div>
            <div class="btn-group-print">
                <button class="btn btn-primary" onclick="downloadPdf()">Download PDF</button>
                <button class="btn btn-secondary" onclick="window.print()">Print</button>
                <button class="btn btn-outline-secondary" onclick="window.history.back()">Back</button>
            </div>
        </div>
    </div>

    <div class="print-grid with-markers" id="printGrid">
        @foreach (var card in unclaimed)
        {
            <div class="tipcard">
                <div class="tipcard-inner">
                    <div class="tipcard-qr">
                        <div class="qr-container">
                            <vc:qr-code data="@card.ClaimUrl" size="140"></vc:qr-code>
                            <partial name="_QrLogoOverlay" model="Model.QrLogo" />
                        </div>
                        <div class="sats">@card.Sats.ToString("N0") sats</div>
                    </div>
                    <div class="tipcard-info">
                        @if (!string.IsNullOrEmpty(Model.LogoUrl))
                        {
                            <img src="@Model.LogoUrl" alt="" class="logo" />
                        }
                        @if (!string.IsNullOrEmpty(Model.CardHeadline))
                        {
                            <div class="headline">@Model.CardHeadline</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.CardText))
                        {
                            <div class="card-text">@Model.CardText</div>
                        }
                        <div class="store-name">@Model.StoreName</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <script>
        (function () {
            var pageStyle = document.getElementById('pageStyle');
            var grid = document.getElementById('printGrid');
            var paperSelect = document.getElementById('paperSize');
            var customSizeEl = document.getElementById('customSize');
            var customWidth = document.getElementById('customWidth');
            var customHeight = document.getElementById('customHeight');
            var columnsSelect = document.getElementById('columns');
            var markersCheck = document.getElementById('cuttingMarkers');

            var sizes = { 'A4': 'A4', 'A3': 'A3', 'letter': '215.9mm 279.4mm' };

            function updatePageSize() {
                var val = paperSelect.value;
                customSizeEl.classList.toggle('visible', val === 'custom');
                var size;
                if (val === 'custom') {
                    size = customWidth.value + 'mm ' + customHeight.value + 'mm';
                } else {
                    size = sizes[val];
                }
                pageStyle.textContent = '@@page { size: ' + size + '; margin: 10mm; }';
            }

            function updateColumns() {
                grid.style.setProperty('--cols', columnsSelect.value);
            }

            function updateMarkers() {
                grid.classList.toggle('with-markers', markersCheck.checked);
            }

            paperSelect.addEventListener('change', updatePageSize);
            customWidth.addEventListener('input', updatePageSize);
            customHeight.addEventListener('input', updatePageSize);
            columnsSelect.addEventListener('change', updateColumns);
            markersCheck.addEventListener('change', updateMarkers);
        })();

        function downloadPdf() {
            var paper = document.getElementById('paperSize').value;
            var columns = document.getElementById('columns').value;
            var markers = document.getElementById('cuttingMarkers').checked;
            var params = 'paper=' + encodeURIComponent(paper)
                + '&columns=' + encodeURIComponent(columns)
                + '&markers=' + encodeURIComponent(markers);
            if (paper === 'custom') {
                params += '&customW=' + encodeURIComponent(document.getElementById('customWidth').value);
                params += '&customH=' + encodeURIComponent(document.getElementById('customHeight').value);
            }
            window.location.href = '@Html.Raw(pdfUrl)' + '?' + params;
        }
    </script>
</body>
</html>
