@using BTCPayServer.Components.QRCode
@using BTCPayServer.Ndeet.Plugins.Tipcards
@using BTCPayServer.Ndeet.Plugins.Tipcards.ViewModels
@using BTCPayServer.Security
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PrintTipcardSetViewModel
@inject ContentSecurityPolicies Csp
@{
    Layout = null;
    var unclaimed = Model.Cards.Where(c => !c.IsClaimed).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Print - @Model.SetName</title>
    <link href="~/main/bootstrap/bootstrap.css" asp-append-version="true" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; margin: 0; }
        .no-print { padding: 16px; text-align: center; background: #f8f9fa; border-bottom: 1px solid #ddd; }
        .print-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            padding: 12px;
        }
        .tipcard {
            border: 2px dashed #ccc;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            page-break-inside: avoid;
            break-inside: avoid;
        }
        .tipcard .logo { max-height: 28px; margin-bottom: 4px; }
        .tipcard .headline { font-size: 11px; font-weight: 600; margin: 2px 0; }
        .tipcard .sats { font-size: 18px; font-weight: 700; margin: 4px 0; }
        .tipcard .qr-container { position: relative; display: inline-block; margin: 4px auto; }
        .tipcard .qr-container img { width: 140px; height: 140px; image-rendering: pixelated; }
        .tipcard .store-name { font-size: 9px; color: #999; }
        .qr-logo-overlay {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 30px; height: 30px; border-radius: 4px; padding: 3px;
            display: flex; align-items: center; justify-content: center;
        }
        .qr-logo-overlay svg { width: 22px; height: 22px; }
        @@media print {
            .no-print { display: none !important; }
            .tipcard { border-color: #000; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <h4>@Model.SetName &mdash; @unclaimed.Count unclaimed cards at @Model.SatsPerCard.ToString("N0") sats each</h4>
        <p class="text-muted mb-2">Only unclaimed cards are shown.</p>
        <button class="btn btn-primary" onclick="window.print()">Print Cards</button>
        <button class="btn btn-secondary ms-2" onclick="window.history.back()">Back</button>
    </div>

    <div class="print-grid">
        @foreach (var card in unclaimed)
        {
            <div class="tipcard">
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="" class="logo" />
                }
                <div class="headline">@Model.CardHeadline</div>
                <div class="sats">@card.Sats.ToString("N0") sats</div>
                <div class="qr-container">
                    <vc:qr-code data="@card.ClaimUrl" size="140"></vc:qr-code>
                    <partial name="_QrLogoOverlay" model="Model.QrLogo" />
                </div>
                <div class="store-name">@Model.StoreName</div>
            </div>
        }
    </div>
</body>
</html>