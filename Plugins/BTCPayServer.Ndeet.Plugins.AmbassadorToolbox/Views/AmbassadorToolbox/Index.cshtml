@model AmbassadorToolboxIndexViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(nameof(AmbassadorToolboxPlugin), "Ambassador Toolbox")
        .SetCategory(WellKnownCategories.Server));
}

<div class="sticky-header">
    <h2>@ViewData["Title"]</h2>
    <button id="page-primary" type="submit" form="AmbassadorToolboxSettingsForm" class="btn btn-primary">Save</button>
</div>

<partial name="_StatusMessage" />

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <form id="AmbassadorToolboxSettingsForm" method="post" asp-action="Index">
            <h3 class="mb-3">Site-wide warning banner</h3>
            <div class="form-group">
                <div class="form-check">
                    <input asp-for="EnableSiteBanner" class="form-check-input" type="checkbox" />
                    <label asp-for="EnableSiteBanner" class="form-check-label">Show warning banner</label>
                </div>
                <div class="form-text">Displays a prominent warning on BTCPay pages and checkout pages, for example to identify a demo instance.</div>
            </div>
            <div class="form-group">
                <label asp-for="SiteBannerText" class="form-label"></label>
                <textarea asp-for="SiteBannerText" class="form-control" rows="2"></textarea>
                <span asp-validation-for="SiteBannerText" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label asp-for="SiteBannerBackgroundColor" class="form-label"></label>
                        <input asp-for="SiteBannerBackgroundColor" class="form-control form-control-color" type="color" />
                        <span asp-validation-for="SiteBannerBackgroundColor" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label asp-for="SiteBannerTextColor" class="form-label"></label>
                        <input asp-for="SiteBannerTextColor" class="form-control form-control-color" type="color" />
                        <span asp-validation-for="SiteBannerTextColor" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h3 class="mb-3">Merchant reports</h3>
            <div class="form-group">
                <div class="form-check">
                    <input asp-for="EnableMerchantReports" class="form-check-input" type="checkbox" />
                    <label asp-for="EnableMerchantReports" class="form-check-label">Enable merchant reports on checkout</label>
                </div>
                <div class="form-text">Adds a public report button to checkout pages so customers can flag suspicious merchants to the server operator.</div>
            </div>
            <div class="form-group">
                <label asp-for="ReportButtonText" class="form-label"></label>
                <input asp-for="ReportButtonText" class="form-control" />
                <span asp-validation-for="ReportButtonText" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

<h3 class="mt-5 mb-3">Merchant Reports</h3>
@if (Model.Reports.Count == 0)
{
    <p class="text-secondary">There are no merchant reports yet.</p>
}
else
{
    <div class="table-responsive-md">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Created</th>
                <th>Merchant</th>
                <th>Invoice</th>
                <th>Reason</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var report in Model.Reports)
            {
                <tr>
                    <td class="text-nowrap">@report.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <div class="fw-semibold">@report.StoreName</div>
                        <div class="text-muted small">@report.StoreId</div>
                    </td>
                    <td>
                        <a asp-controller="UIInvoice" asp-action="Invoice" asp-route-invoiceId="@report.InvoiceId">@report.InvoiceId</a>
                        @if (!string.IsNullOrEmpty(report.OrderId))
                        {
                            <div class="text-muted small">Order @report.OrderId</div>
                        }
                    </td>
                    <td>
                        <div class="fw-semibold">@report.Reason</div>
                        <div class="text-muted">@report.Details</div>
                        @if (!string.IsNullOrEmpty(report.Contact))
                        {
                            <div class="small mt-2">Contact: @report.Contact</div>
                        }
                    </td>
                    <td>
                        @if (report.Resolved)
                        {
                            <span class="badge bg-success">Resolved</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Open</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <form method="post" asp-action="ToggleResolved" asp-route-reportId="@report.Id" class="d-inline">
                            <button type="submit" class="btn btn-link p-0">@(report.Resolved ? "Reopen" : "Resolve")</button>
                        </form>
                        <span> - </span>
                        <form method="post" asp-action="DeleteReport" asp-route-reportId="@report.Id" class="d-inline">
                            <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
