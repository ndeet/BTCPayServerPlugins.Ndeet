@inject SettingsRepository SettingsRepository
@{
    var settings = await SettingsRepository.GetSettingAsync<AmbassadorToolboxSettings>(AmbassadorToolboxPlugin.SettingsKey)
                   ?? new AmbassadorToolboxSettings();
    var enabled = settings.EnableSiteBanner;
    var bannerText = AmbassadorToolboxSettings.NormalizeSiteBannerText(settings.SiteBannerText);
    var backgroundColor = AmbassadorToolboxSettings.NormalizeHexColor(
        settings.SiteBannerBackgroundColor,
        AmbassadorToolboxSettings.DefaultSiteBannerBackgroundColor);
    var textColor = AmbassadorToolboxSettings.NormalizeHexColor(
        settings.SiteBannerTextColor,
        AmbassadorToolboxSettings.DefaultSiteBannerTextColor);
}
@if (enabled)
{
    <style>
        .ambassador-toolbox-site-banner {
            position: sticky;
            top: 0;
            z-index: 1030;
            width: 100%;
            padding: .75rem 1rem;
            font-weight: 700;
            line-height: 1.35;
            text-align: center;
            letter-spacing: .01em;
            box-shadow: 0 2px 12px rgba(0, 0, 0, .18);
        }
        @@media print {
            .ambassador-toolbox-site-banner { display: none !important; }
        }
    </style>
    <div class="ambassador-toolbox-site-banner"
         role="alert"
         style="background-color:@backgroundColor;color:@textColor;">
        @bannerText
    </div>
}
