@model CheckoutModel
@inject SettingsRepository SettingsRepository
@{
    var settings = await SettingsRepository.GetSettingAsync<AmbassadorToolboxSettings>(AmbassadorToolboxPlugin.SettingsKey)
                   ?? new AmbassadorToolboxSettings();
    var enabled = settings.EnableMerchantReports && Model is not null && !string.IsNullOrEmpty(Model.InvoiceId);
    var reportUrl = enabled
        ? Url.Action("ReportMerchant", "AmbassadorToolbox", new { invoiceId = Model.InvoiceId })
        : null;
    var buttonText = string.IsNullOrWhiteSpace(settings.ReportButtonText)
        ? "Report this merchant"
        : settings.ReportButtonText;
}
@if (enabled)
{
    <script>
        (function () {
            const footer = document.querySelector("#Checkout .store-footer");
            if (!footer || document.getElementById("ambassador-toolbox-report-link")) return;

            const link = document.createElement("a");
            link.id = "ambassador-toolbox-report-link";
            link.href = @Safe.Json(reportUrl);
            link.className = "btn btn-link text-danger p-0 mb-3";
            link.textContent = @Safe.Json(buttonText);

            const poweredBy = footer.querySelector(".store-powered-by");
            footer.insertBefore(link, poweredBy || footer.firstChild);
        })();
    </script>
}
